# Copy to .env (which is git-ignored) and fill in:   cp .env.example .env
# Never commit the real .env.

# Telegram bot from @BotFather. Leave empty to disable alerts.
TELEGRAM_TOKEN=
# Optional: auto-discovered if empty (send your bot one message first).
TELEGRAM_CHAT_ID=

# UR5e arm IP on the robot's wired network
ROBOT_IP=10.15.20.50

# Detector weights (.pt, or an *_openvino_model folder for faster CPU inference)
MODEL_PATH=weights/best.pt

# Where annotated mission videos are recorded
SAVE_DIR=~/inspection_runs

# Web UI
WEB_PORT=5000
